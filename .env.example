# 이 파일은 변수 이름과 기본값만 적는다. 실제 값은 .env 나 서버 설정에 둔다 (커밋 금지).

# --- 켜고 끄는 것 (한눈에) ---
# 계약 예시 데이터를 한 번 넣는다. 로컬 · 개발 서버(Access 뒤)에서만 true. 공개 전에 false 로 두고 시드 행을 지운다.
SEED_SAMPLE=false
# 브라우저 접근을 허용할 FE 주소. 쉼표로 여러 개 (예: https://app-<앱이름>.<도메인>)
# 쿠키(Access 로그인)가 실린 요청을 허용하므로 우리 FE 주소만 정확히 넣는다 — 여기 들어간 사이트는 팀원 쿠키로 API 를 읽을 수 있다
# 패턴(*)도 되지만 https://*.vercel.app 처럼 넓게 열면 남의 Vercel 사이트까지 허용된다. PR 미리보기는 목이라 넣지 않아도 된다
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 로그인 · 한도 (BE#10) ---
# 사용자별 하루(한국 날짜) 분석 횟수 — 자료 넣기 · 문항 넣기 · 다시 시도마다 1
DAILY_ANALYSIS_LIMIT=20
# 심사용 테스트 계정. 비밀번호가 비어 있으면 만들지 않는다. 비밀번호는 제출 폼에만 적는다 — 레포가 Public 이라 README 엔 적지 않는다(#34)
TEST_ACCOUNT_LOGIN_ID=test
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_DAILY_LIMIT=200
# 로그인 쿠키에 Secure 를 붙인다. 로컬(http)은 false, 서버(https)는 true — docker-compose.yml 기본값이 true
SESSION_COOKIE_SECURE=false
# 로그인 쿠키 SameSite. FE · BE 가 같은 상위 도메인(app- · api-)이면 lax. 다른 사이트(예: *.vercel.app)에서 부르면 none(+ Secure)
SESSION_COOKIE_SAME_SITE=lax

# --- MCP 연결 주소 (BE#41) ---
# 「연결 주소 만들기」가 돌려주는 주소의 앞부분 — 이 뒤에 토큰이 붙는다. 서버에선 공개 API 주소(예: https://api-<앱이름>.<도메인>/mcp/)
MCP_BASE_URL=http://localhost:8080/mcp/

# --- 차곡이 일 (BE#66) ---
# 차곡이(AI 서버)가 부르는 내부망 MCP 주소 앞부분 — 뒤에 일마다 만든 토큰이 붙는다. 서버에선 docker-compose.yml 이 compose 서비스 이름(http://be:8080/mcp/)으로 정한다
MCP_INTERNAL_BASE_URL=http://localhost:8080/mcp/
# 일 전체 제한 시간(초). 넘으면 끊고 일이 실패(AI_TIMEOUT)가 된다
CHAGOK_TIMEOUT_SECONDS=120
# 일 하나에서 도구를 부를 수 있는 횟수. AI 서버에 넘긴다
CHAGOK_MAX_TOOL_CALLS=8

# --- DB ---
# PostgreSQL JDBC 주소
DB_URL=jdbc:postgresql://localhost:5432/woowang
# DB 사용자
DB_USERNAME=woowang
# DB 비밀번호 — 비워 둔다. 서버에서 설정한다 (로컬 기본값은 개발용 더미)
DB_PASSWORD=

# --- AI 서버 ---
# AI 서버 주소. 로컬은 AI 레포를 8000 으로 띄운 것, 서버에선 compose 서비스 이름(예: http://ai:8000)
AI_BASE_URL=http://localhost:8000
# AI 호출 제한 시간(초). 넘으면 작업이 실패(AI_TIMEOUT)가 된다
AI_TIMEOUT_SECONDS=120
# 사용자가 화면에서 기다리는 AI 호출(홈 입력 가르기)의 제한 시간(초). 넘으면 504 AI_TIMEOUT
AI_SYNC_TIMEOUT_SECONDS=60

# --- 서버 (docker-compose.yml) ---
# 서버에선 DB_URL · DB_USERNAME · AI_BASE_URL 을 compose 가 정한다. 여기선 DB_PASSWORD(위) · SEED_SAMPLE · CORS_ALLOWED_ORIGINS · 로그인 · 한도 · MCP_BASE_URL(위) 와 아래만
# Cloudflare Tunnel 토큰 — Zero Trust 에서 Tunnel 을 만들 때 받는다. 비어 있으면 cloudflared 만 못 뜬다
TUNNEL_TOKEN=
# AI 레포를 클론한 폴더(이 폴더 기준). 기본은 같은 상위 폴더의 WOOWANGTHON_TEAM_12_AI
# AI_DIR=../WOOWANGTHON_TEAM_12_AI

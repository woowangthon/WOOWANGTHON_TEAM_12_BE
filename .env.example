# 이 파일은 변수 이름과 기본값만 적는다. 실제 값은 .env 나 서버 설정에 둔다 (커밋 금지).

# --- 켜고 끄는 것 (한눈에) ---
# 계약 예시 데이터를 한 번 넣는다. 로컬 · 개발 서버(Access 뒤)에서만 true. 공개 전에 false 로 두고 시드 행을 지운다.
SEED_SAMPLE=false
# 브라우저 접근을 허용할 FE 주소. 쉼표로 여러 개 (예: https://app-<앱이름>.<도메인>)
# 쿠키(Access 로그인)가 실린 요청을 허용하므로 우리 FE 주소만 정확히 넣는다 — 여기 들어간 사이트는 팀원 쿠키로 API 를 읽을 수 있다
# 패턴(*)도 되지만 https://*.vercel.app 처럼 넓게 열면 남의 Vercel 사이트까지 허용된다. PR 미리보기는 목이라 넣지 않아도 된다
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- DB ---
# PostgreSQL JDBC 주소
DB_URL=jdbc:postgresql://localhost:5432/woowang
# DB 사용자
DB_USERNAME=woowang
# DB 비밀번호 — 비워 둔다. 서버에서 설정한다 (로컬 기본값은 개발용 더미)
DB_PASSWORD=

# --- AI 서버 ---
# AI 서버 주소. 로컬은 AI 레포를 8000 으로 띄운 것, 서버에선 compose 서비스 이름(예: http://ai:8000)
AI_BASE_URL=http://localhost:8000
# AI 호출 제한 시간(초). 넘으면 작업이 실패(AI_TIMEOUT)가 된다
AI_TIMEOUT_SECONDS=120

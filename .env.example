# 이 파일은 변수 이름과 기본값만 적는다. 실제 값은 .env 나 서버 설정에 둔다 (커밋 금지).

# --- 켜고 끄는 것 (한눈에) ---
# 계약 예시 데이터를 한 번 넣는다. 로컬 · 개발 서버(Access 뒤)에서만 true. 공개 전에 false 로 두고 시드 행을 지운다.
SEED_SAMPLE=false
# 브라우저 접근을 허용할 FE 주소. 쉼표로 여러 개, 패턴 허용 (예: https://app.<도메인>,https://<프로젝트>-*-<팀>.vercel.app)
# https://*.vercel.app 처럼 넓게 열면 남의 Vercel 사이트까지 허용된다 — 우리 프로젝트 · 팀 이름을 넣어 좁힌다
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- DB ---
# PostgreSQL JDBC 주소
DB_URL=jdbc:postgresql://localhost:5432/woowang
# DB 사용자
DB_USERNAME=woowang
# DB 비밀번호 — 비워 둔다. 서버에서 설정한다 (로컬 기본값은 개발용 더미)
DB_PASSWORD=
